   163	    Xtv, Xt, ytv, yt = train_test_split(X_all, y_all, test_size=0.2, random_state=42)
   164	    Xtr, Xv, ytr, yv = train_test_split(Xtv, ytv, test_size=0.125, random_state=42)
   165	    split_random, xgb_main = run_split('Random', Xtr, Xv, Xt, ytr, yv, yt)
   166	    results['split_random'] = split_random
   167	
   168	    # === 2. Group split (legal-dong + apt name) ===
   169	    print(f"\n=== Group split 준비: unique groups = {len(np.unique(groups)):,} ===")
   170	    gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)
   171	    (train_idx, test_idx), = gss.split(X_all, y_all, groups=groups)
   172	    gss2 = GroupShuffleSplit(n_splits=1, test_size=0.125, random_state=42)
   173	    (tr_idx, v_idx), = gss2.split(X_all[train_idx], y_all[train_idx], groups=groups[train_idx])
   174	    real_tr = train_idx[tr_idx]; real_v = train_idx[v_idx]
   175	    split_group, _ = run_split('Group', X_all[real_tr], X_all[real_v], X_all[test_idx],
   176	                                y_all[real_tr], y_all[real_v], y_all[test_idx])
   177	    results['split_group'] = split_group
   178	
   179	    # === 3. Chronological split (train < 2024, test 2024~2025) ===
   180	    print("\n=== Chronological split: train < 202401, val=202401~6, test=202407~ ===")
   181	    tr_mask = ym < 202401
   182	    v_mask = (ym >= 202401) & (ym < 202407)
   183	    t_mask = ym >= 202407
   184	    split_time, _ = run_split('Chronological', X_all[tr_mask], X_all[v_mask], X_all[t_mask],
   185	                               y_all[tr_mask], y_all[v_mask], y_all[t_mask])
   186	    results['split_chronological'] = split_time
   187	
   188	    # === 4. SHAP (random split 기준) ===
   189	    print("\n=== SHAP Analysis (random split XGB) ===")
   190	    shap_df, shap_vals, X_samp, explainer = shap_analysis(xgb_main, Xt, FEATURES)
   191	    print(shap_df.to_string(index=False))
   192	    shap_df.to_csv(os.path.join(RESULTS_DIR, 'shap_importance_v7.csv'), index=False)
   193	    results['SHAP_global'] = {r['변수']: {'mean_abs': float(r['mean_abs_shap_log']),
   194	                                          'pct': float(r['기여도_%'])}
   195	                              for _, r in shap_df.iterrows()}
   196	
   197	    # === 5. Plots ===
   198	    print("\n=== Plots ===")
   199	    plt.figure(figsize=(10, 8))
   200	    shap.summary_plot(shap_vals, X_samp, show=False)
   201	    plt.tight_layout(); plt.savefig(os.path.join(PLOTS_DIR, 'fig4_shap_summary.png'), dpi=200, bbox_inches='tight'); plt.close()
   202	    plt.figure(figsize=(10, 6))
   203	    shap.summary_plot(shap_vals, X_samp, plot_type='bar', show=False)
   204	    plt.tight_layout(); plt.savefig(os.path.join(PLOTS_DIR, 'fig5_shap_bar.png'), dpi=200, bbox_inches='tight'); plt.close()
   205	    for i, feat in enumerate(shap_df['변수'].head(6).tolist()):
   206	        plt.figure(figsize=(8, 6))
   207	        shap.dependence_plot(FEATURES.index(feat), shap_vals, X_samp, show=False)
   208	        plt.tight_layout(); plt.savefig(os.path.join(PLOTS_DIR, f'fig{6+i}_dep_{feat}.png'), dpi=200, bbox_inches='tight'); plt.close()
   209	    print(f"  plots saved to {PLOTS_DIR}")
   210	
   211	    # === 6. 지역 별도 모형 (전체/강남/비강남) — 교수 피드백 핵심 ===
   212	    print("\n=== 지역 별도 모형 (강남구분 제거, 17 features) ===")
   213	    FEATURES_17 = [f for f in FEATURES if f != '강남구분']
   214	    for region_name, mask in [('전체', np.ones(len(df), dtype=bool)),
   215	                              ('강남3구', df['강남구분'] == 1),
   216	                              ('비강남', df['강남구분'] == 0)]:
   217	        print(f"\n  [{region_name}] n={mask.sum():,}")
   218	        Xr = df.loc[mask, FEATURES_17].values
   219	        yr = df.loc[mask, 'log㎡당가격'].values
   220	        Xrtv, Xrt, yrtv, yrt = train_test_split(Xr, yr, test_size=0.2, random_state=42)
   221	        Xrtr, Xrv, yrtr, yrv = train_test_split(Xrtv, yrtv, test_size=0.125, random_state=42)
   222	        _, m_ols = fit_ols(Xrtr, yrtr, Xrt, yrt)
   223	        _, m_rf = fit_rf(Xrtr, yrtr, Xrt, yrt)
   224	        xgb_r, m_xgb = fit_xgb(Xrtr, yrtr, Xrv, yrv, Xrt, yrt, features=FEATURES_17)
   225	        print(f"    OLS R²={m_ols['R2_log']:.4f}  RF R²={m_rf['R2_log']:.4f}  XGB R²={m_xgb['R2_log']:.4f} (MedAPE {m_xgb['Median_APE_%']:.2f}%)")
   226	        # SHAP
   227	        sdf, svals, Xsamp_r, _ = shap_analysis(xgb_r, Xrt, FEATURES_17, sample_size=min(3000, len(Xrt)))
   228	        print(f"    SHAP Top5: {sdf['변수'].head(5).tolist()}")
   229	        results[f'regional_{region_name}'] = {
   230	            'n': int(mask.sum()),
   231	            'OLS': m_ols, 'RF': m_rf, 'XGB': m_xgb,
   232	            'SHAP_top': sdf.head(10).to_dict(orient='records')
   233	        }
   234	
   235	    # === 7. 시기별 3구간 (보조) ===

